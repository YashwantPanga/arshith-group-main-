# Apache (cPanel / most shared hosting). Makes the single-page app work on any address, e.g. /e/my-exam.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /candidate-exam-site/
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . index.html [L]
</IfModule>

<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType application/octet-stream .tflite
</IfModule>

<IfModule mod_headers.c>
  # file names contain a hash, so they can be cached for a year; index.html must always be re-checked
  <FilesMatch "\.(js|css|wasm|tflite|woff2|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "same-origin"
  # the exam needs the camera on this site only
  Header set Permissions-Policy "camera=(self), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/wasm
</IfModule>
